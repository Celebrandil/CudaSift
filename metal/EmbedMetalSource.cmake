# Concatenates the Metal kernel sources into a C++ header (cmake -P script).
# Inputs: IN (files separated by '|'), OUT (generated header).
string(REPLACE "|" ";" files "${IN}")
file(WRITE "${OUT}" "// Generated by metal/EmbedMetalSource.cmake, do not edit\nstatic const char *cudaSiftMetalSource =\n")
foreach(f ${files})
  file(READ "${f}" content)
  file(APPEND "${OUT}" "R\"CUDASIFT_METAL(${content})CUDASIFT_METAL\"\n")
endforeach()
file(APPEND "${OUT}" ";\n")
